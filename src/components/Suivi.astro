---
import type { CollectionEntry } from 'astro:content';
import { enrichir } from '../lib/texte';

// Une condition à jauge ou à compteurs : balisage rendu au build, lu et écrit par
// src/scripts/suivi.js. Utilisé par le module victoire et par les compteurs d'un tour.
type Camp = CollectionEntry<'jeux'>['data']['camps'][number];
type Condition = Extract<CollectionEntry<'modules'>['data'], { type: 'victoire' }>['conditions'][number];

interface Props {
  condition: Condition;
  camps: Camp[];
}
const { condition: c, camps } = Astro.props;
const entiers = (n: number) => Array.from({ length: n }, (_, i) => i + 1);
const s = c.suivi && (c.suivi.type === 'jauge' || c.suivi.type === 'poursuite') ? c.suivi : undefined;
// Jauge : une ligne par camp, ou une seule si le suivi n'est pas par camp.
const parCamp = s?.type === 'jauge' && (s.parCamp ?? camps.length > 0);
const config = s && {
  max: s.type === 'jauge' ? s.max : null,
  alertes: s.alertes,
  defaut: s.defaut ?? '',
};
---

  <section class="course" data-condition={c.id} data-config={config && JSON.stringify(config)}>
    <h2>{c.titre}</h2>
    <div class="quoi" set:html={enrichir(c.description)} />

    {
      s?.type === 'poursuite' && (
        <div class="compteurs">
          {s.compteurs.map((k) => (
            <div class="ctr" data-cle={k.id} data-nom={k.libelle} data-depart={k.depart} data-max={k.max}>
              <div class="titre">{k.libelle}</div>
              <div class="rangee">
                <button type="button" class="pas" data-pas="-1" aria-label={`Diminuer : ${k.libelle}`}>−</button>
                <span class="val" data-val>{k.depart}</span>
                <button type="button" class="pas" data-pas="1" aria-label={`Augmenter : ${k.libelle}`}>+</button>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      s?.type === 'jauge' &&
        (parCamp ? camps : [{ id: '_', nom: c.titre, couleur: 'encre' }]).map((camp) => (
          <div
            class="ligne-jauge"
            style={`--couleur: var(--${camp.couleur})`}
            data-cle={camp.id}
            data-nom={camp.nom}
            data-depart="0"
            data-max={s.max}
          >
            {parCamp && <span class="qui">{camp.nom}</span>}
            <div class="pips">
              {entiers(s.max).map((n) => (
                <button
                  type="button"
                  class="pip"
                  data-n={n}
                  aria-pressed="false"
                  aria-label={`${camp.nom} : ${n} sur ${s.max}`}
                >
                  {n}
                </button>
              ))}
            </div>
          </div>
        ))
    }

    {s && <div class="alerte" data-message aria-live="polite" />}
  </section>