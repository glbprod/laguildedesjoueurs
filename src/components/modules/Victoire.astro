---
import type { CollectionEntry } from 'astro:content';
import { enrichir } from '../../lib/texte';
import { cleStockage } from '../../lib/stockage';
import { groupesDEffets } from '../../lib/jeux';
import Suivi from '../Suivi.astro';
import IlotSuivi from '../IlotSuivi.astro';
import Piste from '../Piste.astro';
import Symboles from '../Symboles.astro';
import Possession from '../Possession.astro';
import Decompte from '../Decompte.astro';

type Camp = CollectionEntry<'jeux'>['data']['camps'][number];

interface Props {
  data: Extract<CollectionEntry<'modules'>['data'], { type: 'victoire' }>;
  camps: Camp[];
  slug: string;
  nom: string;
  stockageDuJeu?: 'module' | 'partie';
}
const { data, camps, slug, nom, stockageDuJeu = 'module' } = Astro.props;

// Clé localStorage préfixée : l'origine glbprod.github.io est partagée.
const stockage = cleStockage(slug, nom, stockageDuJeu);
const groupes = await groupesDEffets(slug);

// Jauges et compteurs (Duel) relèvent de suivi.js ; les autres suivis ont chacun leur îlot.
const aCompteurs = data.conditions.some((c) => !c.suivi || c.suivi.type === 'jauge' || c.suivi.type === 'poursuite');
---

<!--
  Le balisage est entièrement rendu ici. src/scripts/suivi.js ne fait que
  lire/écrire l'état, poser les classes et écrire le message.
  Chaque élément `data-cle` est une valeur suivie (compteur, camp ou valeur
  unique) avec son `data-depart` et son `data-max`.
-->
<div data-suivi data-stockage={stockage} data-partie={stockageDuJeu === 'partie' ? 'true' : undefined}>
  {data.intro && <p class="note" set:html={enrichir(data.intro)} />}

  {
    data.conditions.map((c) => {
      const s = c.suivi;
      if (s?.type === 'piste') return <Piste condition={c} camps={camps} cle={stockage} />;
      if (s?.type === 'symboles') return <Symboles condition={c} conditions={data.conditions} camps={camps} groupes={groupes} cle={stockage} />;
      if (s?.type === 'possession') return <Possession condition={c} conditions={data.conditions} camps={camps} groupes={groupes} cle={stockage} />;
      if (s?.type === 'decompte') return <Decompte condition={c} conditions={data.conditions} camps={camps} cle={stockage} />;
      return <Suivi condition={c} camps={camps} />;
    })
  }

  {
    data.finDePartie && (
      <div class="bloc">
        <p set:html={enrichir(data.finDePartie)} />
      </div>
    )
  }

  {
    stockageDuJeu === 'module' && (
      <div class="remise">
        <button type="button" class="btn" data-nouvelle-partie>Nouvelle partie</button>
      </div>
    )
  }

  {
    data.aReporter && (
      <section class="averti">
        <h2>{data.aReporter.titre}</h2>
        <ul>
          {data.aReporter.points.map((p) => <li set:html={enrichir(p)} />)}
        </ul>
      </section>
    )
  }
</div>

{aCompteurs && <IlotSuivi />}
